# Besoins de déploiement propres au domaine, lus par domain-deploy.yml et domain-cleanup.yml.
# Toutes les variables sont facultatives ; un nom de stack s'écrit sans le suffixe -<env>.

# Compte AWS du domaine : non-core (défaut, rôle AWS_CF_<ENV>_ROLE_ARN)
# ou core (rôle AWS_CF_<ENV>_CORE_ROLE_ARN).
# DEPLOY_ACCOUNT=core

# Stacks dont le Makefile lit les outputs (make <stack>-<env>.outputs), par compte.
# NON_CORE_STACK_OUTPUTS="garance-service-cognito garance-service-edm"
# CORE_STACK_OUTPUTS="garance-domain-wallet"

# Cibles make lancées après make deploy, dans l'ordre.
# POST_DEPLOY_TARGETS="trigger-on-deployed"
