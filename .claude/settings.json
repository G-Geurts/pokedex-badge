{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git status)",
            "Bash(make build)",
            "Bash(npm ci)",
            "Bash(npm run docs:check)",
            "Bash(npm run docs:generate)",
            "Bash(npm run lint)",
            "Bash(npm run lint:fix)",
            "Bash(npm run typecheck)",
            "Bash(npm test)",
            "Bash(npx jest:*)",
            "Bash(sam validate:*)"
        ],
        "deny": ["Read(./.dogfood/**)", "Read(./test.sh)", "Read(./.env)", "Read(./.env.*)"]
    },
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-docs.sh"
                    }
                ]
            }
        ]
    }
}
